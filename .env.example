# =============================================================================
# Bhu Nirikshan (LandGuard AI) - Environment Variables Configuration
# =============================================================================
# Copy this file to `.env.local` for local development.
# In production (Vercel / Cloud), configure these under Project Settings.
# =============================================================================

# --- Supabase Database & Authentication Credentials ---
# Find these in your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Machine Learning API Service (Optional / Microservice) ---
# Point to your deployed FastAPI ML instance or local instance (sih-ml)
# If unset or unreachable, the frontend automatically falls back to the calibrated heuristic engine.
ML_SERVICE_URL=http://localhost:8000

# --- FastAPI Backend Environment (sih-ml/app.py) ---
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
